<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title + faluche side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <!-- Title on the left -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/color_gold_text"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chansons estudiantines"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Faluche on the right -->
            <ImageView
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/faluche" />

        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_list"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_list"
                android:textSize="@dimen/menu_text"
                app:icon="@drawable/ic_musical_note"
                app:iconGravity="textStart"
                app:iconTint="@color/color_on_gold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_search"
                android:textSize="@dimen/menu_text"
                style="@style/Widget.App.Button.Outlined" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_about"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:text="@string/btn_about"
                android:textSize="@dimen/menu_text"
                style="@style/Widget.App.Button.Outlined" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="@color/color_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_buybeer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/about_buy_beer"
                android:textSize="@dimen/menu_text"
                style="@style/Widget.App.Button.Donation" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
