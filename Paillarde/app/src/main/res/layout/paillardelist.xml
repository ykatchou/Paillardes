<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <TextView
        android:id="@+id/ch_titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/list_item_spacer"
        android:paddingLeft="@dimen/list_item_spacer"
        android:textColor="@color/white"
        android:textSize="@dimen/list_titre_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ch_midi"
            android:layout_width="@dimen/list_midi_width"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:paddingLeft="@dimen/list_item_spacer"
            android:textColor="@color/midi_info"
            android:textSize="@dimen/list_tags_size" />

        <TextView
            android:id="@+id/ch_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingRight="@dimen/list_item_spacer"
            android:textColor="@color/tags"
            android:textSize="@dimen/list_tags_size" />
    </LinearLayout>
</LinearLayout>
