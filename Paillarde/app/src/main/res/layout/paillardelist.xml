<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/list_row_padding_h"
    android:paddingEnd="@dimen/list_row_padding_h"
    android:paddingTop="@dimen/list_row_padding_v"
    android:paddingBottom="@dimen/list_row_padding_v"
    android:layout_marginStart="@dimen/card_margin"
    android:layout_marginEnd="@dimen/card_margin"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp">

    <TextView
        android:id="@+id/ch_titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/list_titre_size"
        android:textStyle="bold"
        android:maxLines="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/ch_midi"
            android:layout_width="@dimen/list_midi_width"
            android:layout_height="wrap_content"
            android:textColor="@color/midi_info"
            android:textSize="@dimen/list_tags_size"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/ch_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/list_tags_size" />

    </LinearLayout>

</LinearLayout>
